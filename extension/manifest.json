{
  "manifest_version": 3,
  "name": "EasyFill",
  "version": "0.3.0",
  "description": "Auto-fill Google Forms from your profile",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs"],
  "action": {
    "default_title": "EasyFill"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/connect*",
        "http://localhost:3000/connect*"
      ],
      "js": ["connect.js"],
      "run_at": "document_idle"
    }
  ]
}
