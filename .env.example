# === Application ===
APP_NAME=EasyFill
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# === Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# === Frontend ===
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=easyfill
POSTGRES_USER=easyfill
POSTGRES_PASSWORD=easyfill_dev_password

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === LLM Providers ===
# Primary (ollama for dev, openrouter for prod)
MODEL_PROVIDER=ollama
MODEL_NAME=gpt-4o

# OpenRouter (one key for all cloud models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# OpenAI (direct, optional)
OPENAI_API_KEY=

# Anthropic (direct, optional)
FALLBACK_PROVIDER=anthropic
FALLBACK_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=

# Google (direct, optional)
SECOND_FALLBACK_PROVIDER=google
SECOND_FALLBACK_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=

# Ollama (local, default for dev)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:7b

# AWS Bedrock (optional — use explicit keys, a named profile, or IAM role)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_SESSION_TOKEN=
BEDROCK_PROFILE=

# === Model Gateway ===
MODEL_TIMEOUT=30
MODEL_MAX_RETRIES=3

# === Playwright / Browser ===
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# === Embedding ===
EMBEDDING_MODEL=BAAI/bge-m3
